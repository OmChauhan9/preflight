# Preflight LLM configuration (default: $0 local Ollama, no API key required)
PREFLIGHT_PROVIDER=ollama
PREFLIGHT_MODEL=qwen2.5-coder:7b
PREFLIGHT_BASE_URL=
PREFLIGHT_API_KEY=

# Optional provider presets & provider-specific API keys
# (used automatically when PREFLIGHT_API_KEY is unset):
#
# Groq (free tier available) — https://api.groq.com/openai/v1
# PREFLIGHT_PROVIDER=groq
# PREFLIGHT_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=
#
# Google Gemini (free tier available) — https://generativelanguage.googleapis.com/v1beta/openai
# PREFLIGHT_PROVIDER=gemini
# PREFLIGHT_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
#
# OpenRouter (free models available) — https://openrouter.ai/api/v1
# PREFLIGHT_PROVIDER=openrouter
# PREFLIGHT_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# OPENROUTER_API_KEY=
#
# OpenAI — https://api.openai.com/v1
# PREFLIGHT_PROVIDER=openai
# PREFLIGHT_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
#
# Cerebras — https://api.cerebras.ai/v1
# PREFLIGHT_PROVIDER=cerebras
# PREFLIGHT_MODEL=llama-3.3-70b
# CEREBRAS_API_KEY=
#
# Custom OpenAI-compatible server (e.g. LM Studio, vLLM, llama.cpp):
# PREFLIGHT_PROVIDER=custom
# PREFLIGHT_BASE_URL=http://localhost:8080/v1
# PREFLIGHT_MODEL=your-model-name
# PREFLIGHT_API_KEY=
