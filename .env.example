# Preflight LLM configuration (default: $0 local Ollama, no API key required)
#
# Environment file loading:
#   - Automatically loaded: ~/.config/preflight/.env (or $XDG_CONFIG_HOME/preflight/.env)
#   - Explicitly loaded:    preflight <command> --env-file <path>
# Repo-local .env files in the analyzed repository are NOT auto-loaded for security,
# so untrusted repositories cannot redirect LLM API requests.
#
# Ollama (http://localhost:11434/v1) and qwen2.5-coder:7b are already built-in
# defaults. Keep PREFLIGHT_PROVIDER and PREFLIGHT_MODEL commented out unless you
# want to pin them globally — setting PREFLIGHT_MODEL overrides the default model
# of any cloud preset selected via --provider.
#
# PREFLIGHT_PROVIDER=ollama
# PREFLIGHT_MODEL=qwen2.5-coder:7b
# PREFLIGHT_BASE_URL=
# PREFLIGHT_API_KEY=
# OLLAMA_API_KEY=

# Optional provider presets & provider-specific API keys
# (used automatically when PREFLIGHT_API_KEY is unset and using the preset's
# default base URL; overriding PREFLIGHT_BASE_URL requires explicit PREFLIGHT_API_KEY):
#
# Groq (provider free tier subject to change) — https://api.groq.com/openai/v1
# PREFLIGHT_PROVIDER=groq
# PREFLIGHT_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=
#
# Google Gemini (provider free tier subject to change) — https://generativelanguage.googleapis.com/v1beta/openai
# PREFLIGHT_PROVIDER=gemini
# PREFLIGHT_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=
#
# OpenRouter (:free model availability subject to change) — https://openrouter.ai/api/v1
# PREFLIGHT_PROVIDER=openrouter
# PREFLIGHT_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# OPENROUTER_API_KEY=
#
# OpenAI — https://api.openai.com/v1
# PREFLIGHT_PROVIDER=openai
# PREFLIGHT_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
#
# Cerebras — https://api.cerebras.ai/v1
# PREFLIGHT_PROVIDER=cerebras
# PREFLIGHT_MODEL=llama-3.3-70b
# CEREBRAS_API_KEY=
#
# Custom OpenAI-compatible server (e.g. LM Studio, vLLM, llama.cpp):
# PREFLIGHT_PROVIDER=custom
# PREFLIGHT_BASE_URL=http://localhost:8080/v1
# PREFLIGHT_MODEL=your-model-name
# PREFLIGHT_API_KEY=
